# Copie para .env e use somente credenciais de desenvolvimento.
# Nunca publique o arquivo .env ou chaves reais.
NODE_ENV=development
PIPEDRIVE_COMPANY_DOMAIN=seu-dominio
PIPEDRIVE_API_TOKEN=seu-token-do-pipedrive
BLING_CLIENT_ID=seu-client-id
BLING_CLIENT_SECRET=seu-client-secret
BLING_REDIRECT_URI=http://localhost:3000/api/bling/callback
BLING_ACCESS_TOKEN=seu-token-de-acesso
BLING_REFRESH_TOKEN=seu-token-de-renovacao
MONGODB_URI=sua-uri-do-mongodb
INTEGRATION_API_KEY=coloque-aqui-uma-chave-aleatoria-forte
